# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube a git.

# --- SEC EDGAR (obligatorio para descargar Form 4) ---
# La SEC exige identificarse con nombre y correo reales: "Nombre Apellido correo@ejemplo.com"
TT_SEC_USER_AGENT=

# --- Rutas (opcional) ---
# TT_DATA_DIR=data
# TT_CONFIG_DIR=config

# --- IBKR (solo lectura; cuenta PAPER) ---
# IB Gateway paper = 4002, TWS paper = 7497
TT_IBKR_HOST=127.0.0.1
TT_IBKR_PORT=4002
TT_IBKR_CLIENT_ID=17
# TT_IBKR_ACCOUNT=DU1234567
# Dejar en false: solo se aceptan cuentas paper (prefijo DU).
TT_IBKR_ALLOW_LIVE_READONLY=false

# --- Precios diarios ---
# Fuente: massive | tiingo | eodhd | alpaca | ibkr | csv
TT_PRICE_SOURCE=massive
# Claves gratuitas (regístrate en el sitio de cada proveedor)
TT_MASSIVE_API_KEY=
TT_TIINGO_API_KEY=
# Alpaca (gratis, historia desde 2016): https://alpaca.markets -> cuenta paper -> API Keys.
# Sin comillas y sin espacios alrededor del "=".
TT_ALPACA_KEY_ID=
TT_ALPACA_SECRET_KEY=
# Opcional (pago, ~US$20 un mes) para validar con historia larga e incluye deslistadas:
TT_EODHD_API_KEY=
TT_BENCHMARK_TICKER=SPY
TT_BENCHMARK_SECONDARY_TICKER=IWM

# --- Rotación de ETFs (rotacion-v1) ---
# Fuente de precios de los ETFs: tiingo (recomendada, historia desde ~2003) | alpaca (solo
# desde 2016: sirve para la señal mensual, no para el backtest) | eodhd | csv.
# La clave de Tiingo es TT_TIINGO_API_KEY (arriba). La tasa del Tesoro viene de FRED, sin clave.
TT_ETF_PRICE_SOURCE=tiingo
